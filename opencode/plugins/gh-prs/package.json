{
  "name": "opencode-gh-prs",
  "version": "0.1.0",
  "private": true,
  "description": "Track a session's registered GitHub PRs, CI checks, and agent-reported work status in OpenCode.",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "test": "bun test ./src",
    "test:browser": "playwright test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:browser && bun run build",
    "build": "bun --bun vite build",
    "dev": "bun --bun vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tui.json"
  },
  "dependencies": {
    "@opencode/plugin": "0.0.0-dev-639"
  },
  "devDependencies": {
    "@opencode/theme": "0.0.0-dev-639",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@playwright/test": "1.65.0",
    "@types/bun": "^1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "solid-js": "^1.9.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.12"
  }
}
