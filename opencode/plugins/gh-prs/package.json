{
  "name": "opencode-gh-prs",
  "version": "0.1.0",
  "private": true,
  "description": "Review the GitHub pull requests a session mentions without leaving OpenCode: description, diff, CI checks, comments, merge.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun --bun vite build",
    "dev": "bun --bun vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tui.json"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.2.0",
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "@types/bun": "^1.4.4",
    "solid-js": "^1.9.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.12"
  }
}
